<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      IPTV providers (Xtream Codes, Stalker portals, naked M3U hosts) commonly
      ship HTTP-only endpoints, so we keep cleartext allowed by default.

      Optional update endpoints use GitHub Releases only when a Tviito TV build
      explicitly opts in through TVIITO_UPDATE_* values. Telemetry endpoints are
      intentionally not allowlisted here: fork builds keep them blank/disabled,
      and any future own endpoint must be HTTPS.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">api.github.com</domain>
    </domain-config>
</network-security-config>
